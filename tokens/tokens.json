    "heroEntrance": { "image": "scale 1.07→1, 2s", "content": "fade+translateY 20px, 0.9s, atraso 0.2/0.38/0.52/0.62s" },
    "searchGo": { "duration": "620ms", "navigateAfter": "580ms" },
    "reducedMotion": "todas as animações desligadas"
