  },
  "font": {
    "display": { "family": "Montserrat", "source": "Google Fonts / @fontsource/montserrat", "weights": [500, 600, 700, 800] },
    "text": { "family": "Aileron", "source": "fonts/aileron-*.woff2 (licença CC0)", "weights": [300, 400, 600] },
    "brand-only": { "family": "Novelin", "use": "não usada no site; só existe dentro da logo (SVG). Verificar licença web antes de qualquer uso." }
  },
  "type": {
    "h1": { "mobile": 34, "desktop": 54, "weight": 800, "tracking": "-0.02em", "lineHeight": 1.12 },
    "h2": { "mobile": 28, "desktop": 40, "weight": 800, "tracking": "-0.02em", "lineHeight": 1.15 },
    "h3": { "mobile": 20, "desktop": 24, "weight": 700, "tracking": "-0.01em", "lineHeight": 1.25 },
